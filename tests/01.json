{
  "app": {
    "name": "Test 01 button properties",
    "purpose": "test 01",
    "version": "1.0",
    "version_date": ""
  },
  "target": {
    "model": "CYD 2.8 (ESP32 + ILI9341 + XPT2046)",
    "processor": "ESP32",
    "board": "board_cyd",
    "display": {
      "model": "ILI9341",
      "width": 320,
      "height": 240,
      "interface": "SPI",
      "driver": "ili9341.py"
    },
    "touch": {
      "model": "XPT2046",
      "type": "resistive",
      "interface": "SPI",
      "driver": "touch_xpt2046.py"
    },
    "fonts": [
      {
        "name": "default",
        "sizes": [
          8,
          16,
          24
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Arial",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Times New Roman",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Comic Sans MS",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Sans",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Sans Mono",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Serif",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      }
    ]
  },
  "screens": [
    {
      "id": "main",
      "orientation": "landscape",
      "width": 320,
      "height": 240,
      "background": "black",
      "widgets": [
        {
          "widget": "button",
          "id": "button1",
          "x": 30,
          "y": 40,
          "w": 120,
          "h": 60,
          "visible": true,
          "enabled": true,
          "background": "green",
          "color": "white",
          "border": {
            "color": "black",
            "width": 1
          },
          "text": "Colour",
          "alignment": "center",
          "accepts_input": false,
          "events": [
            "click"
          ],
          "font_type": "default",
          "font_size": 16,
          "bold": false,
          "italic": false
        },
        {
          "widget": "button",
          "id": "button2",
          "x": 170,
          "y": 40,
          "w": 120,
          "h": 60,
          "visible": true,
          "enabled": true,
          "background": "gray",
          "color": "white",
          "border": {
            "color": "black",
            "width": 1
          },
          "text": "OFF",
          "alignment": "center",
          "accepts_input": false,
          "events": [
            "click"
          ],
          "font_type": "default",
          "font_size": 16,
          "bold": false,
          "italic": false
        },
        {
          "widget": "label",
