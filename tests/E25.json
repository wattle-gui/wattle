{
  "app": {
    "name": "Design",
    "purpose": "",
    "version": "1.0",
    "version_date": ""
  },
  "target": {
    "model": "CYD 2.8 (ESP32 + ILI9341 + XPT2046)",
    "processor": "ESP32",
    "board": "board_cyd",
    "device": "cyd",
    "display": {
      "model": "ILI9341",
      "width": 320,
      "height": 240,
      "interface": "SPI",
      "driver": "ili9341.py"
    },
    "touch": {
      "model": "XPT2046",
      "type": "resistive",
      "interface": "SPI",
      "driver": "touch_xpt2046.py"
    },
    "fonts": [
      {
        "name": "default",
        "sizes": [
          8,
          16,
          24
        ],
        "styles": [
          "bold",
          "italic"
        ]
      }
    ]
  },
  "screens": [
    {
      "id": "screen1",
      "orientation": "landscape",
      "width": 320,
      "height": 240,
      "background": "black",
      "widgets": [
        {
          "widget": "button",
          "id": "button1",
          "x": 112,
          "y": 96,
          "w": 120,
          "h": 40,
          "visible": true,
          "enabled": true,
          "background": "green",
          "color": "white",
          "border": {
            "color": "black",
            "width": 1
          },
          "text": "Button1",
          "alignment": "center",
          "accepts_input": false,
          "events": [
            "click"
          ],
          "font_type": "default",
          "font_size": "default",
          "bold": false,
          "italic": false
        }
      ]
    },
    {
      "id": "screen2",
      "orientation": "portrait",
      "width": 240,
      "height": 320,
      "background": "black",
      "widgets": [
        {
          "widget": "button",
          "id": "button2",
          "x": 56,
          "y": 128,
          "w": 120,
          "h": 40,
          "visible": true,
          "enabled": true,
          "background": "green",
          "color": "white",
          "border": {
            "color": "black",
            "width": 1
          },
          "text": "Button2",
          "alignment": "center",
          "accepts_input": false,
          "events": [
            "click"
          ],
          "font_type": "default",
          "font_size": "default",
          "bold": false,
          "italic": false
        }
      ]
    }
  ]
}
