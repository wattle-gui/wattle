{
  "app": {
    "name": "Test 02 switch and checkbox",
    "purpose": "test 02",
    "version": "1.0",
    "version_date": ""
  },
  "target": {
    "model": "CYD 2.8 (ESP32 + ILI9341 + XPT2046)",
    "processor": "ESP32",
    "board": "board_cyd",
    "display": {
      "model": "ILI9341",
      "width": 320,
      "height": 240,
      "interface": "SPI",
      "driver": "ili9341.py"
    },
    "touch": {
      "model": "XPT2046",
      "type": "resistive",
      "interface": "SPI",
      "driver": "touch_xpt2046.py"
    },
    "fonts": [
      {
        "name": "default",
        "sizes": [
          8,
          16,
          24
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Arial",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Times New Roman",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Comic Sans MS",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Sans",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Sans Mono",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Serif",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      }
    ]
  },
  "screens": [
    {
      "id": "main",
      "orientation": "landscape",
      "width": 320,
      "height": 240,
      "background": "black",
      "widgets": [
        {
          "widget": "switch",
          "id": "switch1",
          "x": 20,
          "y": 30,
          "w": 140,
          "h": 28,
          "visible": true,
          "enabled": true,
          "background": "transparent",
          "color": "white",
          "text": "Switch",
          "value": false,
          "events": [
            "changed"
          ],
          "font_type": "default",
          "font_size": 16,
          "bold": false,
          "italic": false
        },
        {
          "widget": "checkbox",
          "id": "checkbox1",
          "x": 180,
          "y": 30,
          "w": 130,
          "h": 24,
          "visible": true,
          "enabled": true,
          "background": "transparent",
          "color": "white",
          "text": "Check",
          "value": false,
          "events": [
            "changed"
          ],
          "font_type": "default",
          "font_size": 16,
          "bold": false,
          "italic": false
        },
        {
          "widget": "label",
          "id": "label1",
          "x": 20,
          "y": 100,
          "w": 280,
          "h": 24,
          "visible": true,
          "enabled": true,
          "background": "black",
          "color": "white",
          "border": {
            "color": "black",
            "width": 0
          },
          "text": "Switch: OFF",
          "alignment": "left",
          "font_type": "default",
          "font_size": 16,
          "bold": false,
          "italic": false
        },
        {
          "widget": "label",
          "id": "label2",
          "x": 20,
          "y": 140,
          "w": 280,
          "h": 24,
          "visible": true,
          "enabled": true,
          "background": "black",
          "color": "white",
          "border": {
            "color": "black",
            "width": 0
          },
          "text": "Check: no",
          "alignment": "left",
          "font_type": "default",
          "font_size": 16,
          "bold": false,
          "italic": false
        }
      ]
    }
  ]
}
