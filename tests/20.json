      "id": "main",
      "orientation": "landscape",
      "width": 320,
      "height": 240,
      "background": "black",
      "widgets": [
        {
          "widget": "choice",
          "id": "choice1",
          "x": 8,
          "y": 8,
          "w": 150,
          "h": 116,
          "visible": true,
          "enabled": true,
          "style": "radio",
          "orientation": "vertical",
          "items": [
            "Red",
            "Green",
            "Blue",
            "Yellow"
          ],
          "selected": 1,
          "background": "black",
          "color": "white",
          "border": {
            "color": "gray",
            "width": 1
          },
          "events": [
            "changed"
          ],
          "font_type": "default",
          "font_size": 16,
          "bold": false,
          "italic": false
        },
        {
