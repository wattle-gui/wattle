{
  "app": {
    "name": "E24 new widgets",
    "purpose": "test 24",
    "version": "1.0",
    "version_date": ""
  },
  "target": {
    "model": "CYD 2.8 (ESP32 + ILI9341 + XPT2046)",
    "processor": "ESP32",
    "board": "board_cyd",
    "display": {
      "model": "ILI9341",
      "width": 320,
      "height": 240,
      "interface": "SPI",
      "driver": "ili9341.py"
    },
    "touch": {
      "model": "XPT2046",
      "type": "resistive",
      "interface": "SPI",
      "driver": "touch_xpt2046.py"
    },
    "fonts": [
      {
        "name": "default",
        "sizes": [
          8,
          16,
          24
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Arial",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Times New Roman",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Comic Sans MS",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Sans",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Sans Mono",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Serif",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      }
    ]
  },
  "screens": [
    {
      "id": "main",
      "orientation": "landscape",
      "width": 320,
      "height": 240,
      "background": "black",
      "widgets": [
        {
          "widget": "gauge",
          "id": "gauge1",
          "x": 8,
          "y": 8,
          "w": 140,
          "h": 140,
          "visible": true,
          "background": "gray",
          "color": "red",
          "min": 0,
          "max": 100,
          "value": 40,
          "text": "SPEED",
          "show_value": true,
          "ticks": 10,
          "diameter": 0,
          "sweep": 270,
          "show_ticks": true,
          "font_size": "default"
        },
        {
          "widget": "stepper",
          "id": "stepper1",
          "x": 160,
          "y": 8,
          "w": 150,
          "h": 40,
          "visible": true,
          "enabled": true,
          "background": "transparent",
          "color": "green",
          "min": 0,
          "max": 100,
          "value": 40,
          "step": 5,
          "events": [
            "changed"
          ],
          "font_type": "default",
          "font_size": 16,
          "bold": false,
          "italic": false
        },
        {
          "widget": "waveform",
          "id": "waveform1",
          "x": 160,
          "y": 56,
          "w": 152,
          "h": 92,
          "visible": true,
          "background": "black",
          "color": "green",
          "min": 0,
          "max": 100,
          "points": 40,
          "style": "line",
          "grid": true,
          "title": "Wave",
          "update_ms": 100,
          "font_size": "default"
        },
        {
          "widget": "barchart",
          "id": "barchart1",
          "x": 8,
          "y": 156,
          "w": 304,
          "h": 84,
          "visible": true,
          "background": "black",
          "color": "orange",
          "min": 0,
          "max": 1000,
          "bars": 5,
          "grid": true,
          "title": "Rainfall (mm)",
          "labels": [
            "2021",
            "2022",
            "2023",
            "2024",
            "2025"
          ],
          "values": [
            640,
            910,
            520,
            780,
            430
          ],
          "show_values": true,
          "update_ms": 0,
          "font_size": "default"
        }
      ]
    }
  ]
