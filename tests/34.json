{
  "app": {
    "name": "Test 34 miniature scope",
    "purpose": "test 34",
    "version": "1.0",
    "version_date": ""
  },
  "target": {
    "model": "CYD 2.8 (ESP32 + ILI9341 + XPT2046)",
    "processor": "ESP32",
    "board": "board_cyd",
    "display": {
      "model": "ILI9341",
      "width": 320,
      "height": 240,
      "interface": "SPI",
      "driver": "ili9341.py"
    },
    "touch": {
      "model": "XPT2046",
      "type": "resistive",
      "interface": "SPI",
      "driver": "touch_xpt2046.py"
    },
    "fonts": [
      {
        "name": "default",
        "sizes": [
          8,
          16,
          24
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Arial",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Times New Roman",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Comic Sans MS",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Sans",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Sans Mono",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Serif",
        "sizes": [
          12,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      }
    ]
  },
  "screens": [
    {
      "id": "main",
      "orientation": "landscape",
      "width": 320,
      "height": 240,
      "background": "black",
      "widgets": [
        {
          "widget": "waveform",
          "id": "waveform1",
          "x": 4,
          "y": 4,
          "w": 312,
          "h": 170,
          "visible": true,
          "background": "black",
          "color": "green",
          "min": 0,
          "max": 100,
          "points": 150,
          "style": "line",
          "grid": true,
          "title": "Signal generator",
          "update_ms": 60,
          "font_size": "default"
        },
        {
          "widget": "label",
          "id": "label1",
          "x": 4,
          "y": 180,
          "w": 150,
          "h": 20,
          "visible": true,
          "enabled": true,
          "background": "black",
          "color": "white",
          "border": {
            "color": "black",
            "width": 0
          },
          "text": "frequency",
          "alignment": "left",
          "font_type": "default",
          "font_size": 8,
          "bold": false,
          "italic": false
        },
        {
          "widget": "slider",
          "id": "slider1",
          "x": 4,
          "y": 200,
          "w": 220,
          "h": 30,
          "visible": true,
          "enabled": true,
          "background": "gray",
          "color": "green",
          "min": 1,
          "max": 20,
          "value": 3,
          "step": 1,
          "events": [
            "changed"
          ]
        },
        {
          "widget": "button",
          "id": "button1",
          "x": 236,
          "y": 196,
          "w": 80,
          "h": 36,
          "visible": true,
          "enabled": true,
          "background": "green",
          "color": "black",
          "border": {
            "color": "black",
            "width": 1
          },
          "text": "Clear",
          "alignment": "center",
          "accepts_input": false,
          "events": [
            "click"
          ],
          "font_type": "default",
          "font_size": 16,
          "bold": false,
          "italic": false
        }
      ]
    }
  ]
