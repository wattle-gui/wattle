          "h": 28,
          "visible": true,
          "enabled": true,
          "background": "gray",
          "color": "green",
          "min": 0,
          "max": 100,
          "value": 30,
          "step": 1,
          "events": [
            "changed"
          ]
        },
        {
          "widget": "progressbar",
