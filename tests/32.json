  "screens": [
    {
      "id": "main",
      "orientation": "landscape",
      "width": 320,
      "height": 240,
      "background": "black",
      "widgets": [
        {
          "widget": "waveform",
          "id": "waveform1",
          "x": 4,
          "y": 4,
          "w": 312,
          "h": 100,
          "visible": true,
          "background": "black",
          "color": "green",
          "min": 0,
          "max": 100,
          "points": 40,
          "style": "bars",
          "grid": true,
          "title": "Waveform, style bars",
          "update_ms": 150,
          "font_size": "default"
        },
        {
          "widget": "barchart",
          "id": "barchart1",
          "x": 4,
          "y": 112,
          "w": 200,
          "h": 120,
          "visible": true,
          "background": "black",
          "color": "orange",
          "min": 0,
          "max": 100,
          "bars": 8,
          "grid": true,
          "title": "Barchart",
          "labels": [],
          "values": [],
          "show_values": false,
          "update_ms": 0,
          "font_size": "default"
        },
        {
          "widget": "button",
          "id": "button1",
          "x": 212,
          "y": 112,
          "w": 104,
