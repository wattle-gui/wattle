          "visible": true,
          "background": "gray",
          "color": "red",
          "min": 0,
          "max": 100,
          "value": 40,
          "text": "LIVE",
          "show_value": true,
          "ticks": 12,
          "diameter": 0,
          "sweep": 270,
          "show_ticks": true,
          "font_size": 12,
          "font_type": "Arial"
