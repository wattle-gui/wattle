{
  "app": {
    "name": "Wattle in the browser: hello",
    "purpose": "browser demo",
    "version": "1.0",
    "version_date": ""
  },
  "target": {
    "model": "Browser (any ESP32 with Wi-Fi, no screen needed)",
    "processor": "ESP32",
    "board": "board_browser",
    "display": {
      "model": "Browser",
      "width": 360,
      "height": 640,
      "interface": "Wi-Fi (web page)",
      "driver": "(none: the browser draws)"
    },
    "touch": {
      "model": "Browser",
      "type": "finger or mouse",
      "interface": "Wi-Fi (web page)",
      "driver": "(none: the browser sends the taps)"
    },
    "fonts": [
      {
        "name": "default",
        "sizes": [
          8,
          16,
          24
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Arial",
        "sizes": [
          10,
          12,
          14,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Times New Roman",
        "sizes": [
          10,
          12,
          14,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "Comic Sans MS",
        "sizes": [
          10,
          12,
          14,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Sans",
        "sizes": [
          10,
          12,
          14,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Sans Mono",
        "sizes": [
          10,
          12,
          14,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      },
      {
        "name": "DejaVu Serif",
        "sizes": [
          10,
          12,
          14,
          16,
          20,
          24,
          32
        ],
        "styles": [
          "bold",
          "italic"
        ]
      }
    ]
  },
  "screens": [
    {
      "id": "main",
      "orientation": "portrait",
      "width": 360,
      "height": 640,
      "background": "black",
      "widgets": [
        {
          "widget": "label",
          "id": "label1",
          "x": 20,
          "y": 60,
          "w": 320,
          "h": 60,
          "visible": true,
          "enabled": true,
          "background": "black",
          "color": "white",
          "border": {
            "color": "black",
            "width": 0
          },
          "text": "Wattle is running!",
          "alignment": "center",
          "font_type": "default",
          "font_size": 24,
          "bold": false,
          "italic": false
        },
        {
          "widget": "label",
          "id": "label2",
          "x": 20,
          "y": 140,
          "w": 320,
          "h": 40,
          "visible": true,
          "enabled": true,
          "background": "black",
          "color": "white",
          "border": {
            "color": "black",
            "width": 0
          },
          "text": "Taps: 0",
          "alignment": "center",
          "font_type": "default",
          "font_size": 24,
          "bold": false,
          "italic": false
        },
        {
          "widget": "button",
          "id": "button1",
          "x": 20,
          "y": 210,
          "w": 320,
          "h": 70,
          "visible": true,
          "enabled": true,
          "background": "green",
          "color": "white",
          "border": {
            "color": "black",
            "width": 1
          },
          "text": "Tap me",
          "alignment": "center",
          "accepts_input": false,
          "events": [
            "click"
          ],
          "font_type": "default",
          "font_size": 24,
          "bold": false,
          "italic": false
        }
      ]
    }
  ]
}