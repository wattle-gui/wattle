#!/bin/bash
# wattle -- one command for everything. Type  ./wattle help  to see what it can do.
CALLER="$PWD"        # the folder you typed the command in: your own files are looked for there first
cd "$(dirname "$0")" || exit 1
HERE="$PWD"
if [ -x .venv/bin/python ]; then PY="$HERE/.venv/bin/python"; export PATH="$HERE/.venv/bin:$PATH"; else PY=python3; fi

need_install() { if [ ! -x .venv/bin/mpremote ]; then echo "The tools are not installed yet. Run:  ./wattle install"; exit 1; fi; }

case "$1" in
  install)  shift
            case " $* " in *" --browser "*) exec "$PY" install_wattle.py "$@" ;; esac     # the browser version: any ESP32 with Wi-Fi
            exec ./install.sh "$@" ;;
  new)      exec "$PY" wattle.py new "${@:2}" ;;     # ./wattle new myapp  -> a folder with a ready-to-run starter; asks which screen it is for
  deploy)   need_install; shift
            args=()
            for f in "$@"; do          # a name that exists in the folder you typed the command in means that file
                case "$f" in --*|/*) ;; *)
                    found=0     # first the folder you typed the command in, then your projects folder
                    for c in "$f" "$f.json"; do [ -e "$CALLER/$c" ] && { f="$CALLER/$f"; found=1; break; }; done
                    [ "$found" = 1 ] || for c in "$f" "$f.json"; do [ -e "$HERE/projects/$c" ] && { f="$HERE/projects/$f"; break; }; done ;; esac
                args+=("$f")
            done
            set -- "${args[@]}"
            if [ $# -eq 1 ]; then      # one name: a folder, or a design (dad.json or just dad)
                one="$1"
                if [ -d "$one" ]; then
                    dir="$one"
                    n=$(ls "$dir"/*.json 2>/dev/null | wc -l)
                    [ "$n" -ge 1 ] || { echo "The folder $dir holds no design (.json file)."; exit 1; }
                    [ "$n" = 1 ] || { echo "The folder $dir holds $n designs. Name the one you want, for example:  ./wattle deploy $dir/NAME  (NAME is the design's name without .json)."; exit 1; }
                    design=$(ls "$dir"/*.json)
                else
                    design="$one"; [ -f "$design" ] || design="$one.json"
                    [ -f "$design" ] || {
                        echo "I cannot find the design '$one.json' in this folder or in your projects folder ($HERE/projects)."
                        for d in "$HERE/projects" "$CALLER"; do
                            [ -f "$d/$one.py" ] && { echo "I did find a script called $one.py in $d, but there is no design with the same name next to it."; echo "Save your design in the Editor under the same name (File, Save As...), in that folder."; break; }
                        done
                        echo "Or give the full path of your design, for example:  ./wattle deploy $HERE/projects/$one"; exit 1; }
                fi
                base="${design%.json}"
                if [ -f "$base.py" ]; then script="$base.py"
                elif [ -f "$(dirname "$design")/Project_1.py" ]; then script="$(dirname "$design")/Project_1.py"
                else                       # no script named like the design: take the folder's only script, whatever its name
                    dd="$(dirname "$design")"; np=$(ls "$dd"/*.py 2>/dev/null | wc -l)
                    if [ "$np" = 1 ]; then script=$(ls "$dd"/*.py)
                    elif [ "$np" = 0 ]; then echo "There is no script next to $(basename "$design"). Save your script (a .py file) in the same folder."; exit 1
                    else echo "There are $np scripts next to $(basename "$design"), and none is named $(basename "$base").py. Give the one you want the design's name, or name both files:  ./wattle deploy $design /path/to/script.py"; exit 1; fi
                fi
                set -- "$design" "$script"
            fi
            exec "$PY" tools/deploy.py "$@" ;;
  check)    need_install; exec "$PY" tools/check_script.py ;;
  reset)    need_install; exec tools/reset.sh "${@:2}" ;;
  test)     need_install; exec "$PY" tests/run_test.py "${@:2}" ;;
  fonts)    need_install; exec "$PY" tools/make_fonts.py "${@:2}" ;;
  images)   need_install; exec "$PY" tools/make_images.py "${@:2}" ;;
  pick)     need_install; exec "$PY" tools/picker.py "${@:2}" ;;
  remove)   exec "$PY" tools/remove_wattle.py "${@:2}" ;;     # start again from the beginning (asks before it deletes anything)
  uninstall) exec "$PY" tools/remove_wattle.py --uninstall ;;  # take Wattle off this computer (asks first)
  setup)    exec "$PY" wattle.py setup "${@:2}" ;;    # a NEW plain ESP32 in one go: a ready-made image, the Wi-Fi from a phone
  pin)      exec "$PY" pin_setup.py "${@:2}" ;;       # browser boards: a PIN or password, sealed on the board
  wifi)     exec "$PY" wifi_setup.py "${@:2}" ;;     # needs only Python + pyserial, like install_wattle.py
  help|""|-h|--help)
cat <<'TXT'
Wattle -- usage:  ./wattle <command>

  install [--yes]    guided installation: tools, board port, MicroPython, program files, demo
  install --browser [--name NAME] [--yes]   the browser version: a phone, tablet or PC is the screen (the ESP32 needs MicroPython)
  setup [--yes]      set up a NEW plain ESP32 in one go (it writes a ready-made image; this ERASES the ESP32); the Wi-Fi is typed on your phone
  new NAME           make a starter app in the folder NAME (a label and a button)
  deploy NAME        copy the app NAME (a folder, or a design NAME.json with its script NAME.py) to the board, check it, and start it
  deploy DESIGN.json SCRIPT.py     the same for two files with any names
  check              check the design and script that are on the board; explains mistakes
  test N             load test number N (a ready-made example) onto the board
  reset              restart the board
  uninstall          remove Wattle from this computer (asks first); your projects and the ESP32 stay
  remove             start again: empty the board, remove Wattle from the computer, restart the installation (asks first)
  pin                put a PIN or password on a browser board (it is asked once when a page is opened); --remove takes it off
  wifi               put your Wi-Fi name and password on the board (file wifi.dat; nothing is kept on the computer)
  fonts / images / pick    the font converter, picture converter and hardware picker (see chapter 6)

Examples:   ./wattle install     ./wattle new hello     ./wattle deploy hello
TXT
  ;;
  *) echo "Unknown command '$1'. Type  ./wattle help"; exit 1 ;;
esac
